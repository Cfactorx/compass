#!/usr/bin/env bash
# pre-commit hook — 罗盘分金（V1.6 P1-1）
# 用法：在 .git/hooks/pre-commit 软链本文件
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# 行为：commit 前自动重合并 + 跑测试，确保 index.html 与源文件同步
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] 重合并 + 跑测试..."
node scripts/merge.js
node tests/run.js
echo "[pre-commit] ✓ 通过"
