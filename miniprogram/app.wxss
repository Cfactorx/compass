/* =====================================================================
 * app.wxss — 全局样式（桃橙主题，与 H5 版视觉一致）
 * 注意：WXSS 不支持 :root 变量，改用 page 级 CSS 变量 + 字面值兜底
 * ===================================================================== */
page {
  --primary: #EF7D2D;
  --primary-deep: #D96A1F;
  --primary-soft: #FBE9D8;
  --ink: #3D3229;
  --muted: #8A7A6D;
  --bg: #FFF6EE;
  --card: #FFFFFF;
  --line: #F0E2D2;
  --red: #C2402A;
  --good: #2E8B57;
  --warn: #E8A33D;
  background: #FFF6EE;
  color: #3D3229;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
}

.wrap { padding: 12px 12px 24px; }

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(217, 106, 31, .10);
  padding: 14px 14px 12px;
  margin-top: 12px;
}
.card:first-child { margin-top: 0; }

/* ---------- 判读结论 ---------- */
.conc {
  font-size: 17px;
  font-weight: 800;
  line-height: 1.5;
  letter-spacing: .5px;
}
.conc .tag {
  font-size: 12px;
  font-weight: 700;
  border-radius: 8px;
  padding: 2px 8px;
  margin-left: 6px;
  vertical-align: 2px;
  display: inline-block;
}
.tag-ok { background: #E4F3EA; color: #2E8B57; }
.tag-warn { background: #FDF0DA; color: #B4771A; }
.tag-bad {
  background: #8B1A1A;
  color: #FFFFFF;
  border: 1.5px solid #5A0F0F;
  font-weight: 800;
  letter-spacing: .5px;
  box-shadow: 0 1px 0 rgba(0, 0, 0, .15);
}

/* ---------- 参数条 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 10px 0 2px;
}
.chips .chip {
  font-size: 11.5px;
  background: #FAF3EA;
  color: #7A6A5B;
  border-radius: 8px;
  padding: 3px 9px;
  margin: 0 6px 6px 0;
}
.chips .chip.hl { background: #FBE9D8; color: #D96A1F; font-weight: 700; }
.chips .chip.alert { background: #FBE7E2; color: #C2402A; font-weight: 700; }

/* ---------- 键值表 ---------- */
.kv { margin-top: 8px; }
.kv .row {
  display: flex;
  padding: 6px 0;
  border-bottom: 1px dashed #F5EADF;
  font-size: 12.5px;
}
.kv .row:last-child { border-bottom: none; }
.kv .row .k { width: 88px; color: #8A7A6D; flex-shrink: 0; }
.kv .row .v { flex: 1; line-height: 1.6; word-break: break-all; }

/* ---------- 按钮 ---------- */
.btn-row { display: flex; margin-top: 12px; }
.btn {
  flex: 1;
  border-radius: 10px;
  padding: 10px 0;
  font-size: 14px;
  font-weight: 700;
  background: #EF7D2D;
  color: #FFFFFF;
  text-align: center;
  line-height: 1.4;
  margin: 0 4px;
}
.btn:first-child { margin-left: 0; }
.btn:last-child { margin-right: 0; }
.btn.ghost { background: #FAF0E5; color: #D96A1F; }
.btn.plain { background: #F2EDE6; color: #7A6A5B; }
.btn.disabled { opacity: .45; }
.btn.sm { padding: 6px 0; font-size: 12.5px; }
.btn-danger { background: #FBE7E2; color: #C2402A; }

/* ---------- 空态 ---------- */
.empty {
  color: #8A7A6D;
  text-align: center;
  font-size: 13px;
  padding: 36px 16px;
  line-height: 1.8;
}

/* ---------- 设置项 ---------- */
.set-group {
  background: #FFFFFF;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(217, 106, 31, .10);
  padding: 0 14px;
  margin-bottom: 12px;
}
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 0;
  border-bottom: 1px solid #F0E2D2;
}
.set-row:last-child { border-bottom: none; }
.set-row .lab { font-size: 14px; flex: 1; padding-right: 10px; }
.set-row .lab .sub {
  display: block;
  font-size: 11px;
  color: #8A7A6D;
  margin-top: 3px;
  line-height: 1.5;
}
.set-row.col { flex-direction: column; align-items: stretch; }
.set-row.col .lab { padding-right: 0; }

/* 分段控件 */
.seg {
  display: flex;
  background: #F4EADB;
  border-radius: 9px;
  padding: 2px;
  flex-shrink: 0;
}
.seg .sg-btn {
  padding: 6px 10px;
  border-radius: 7px;
  font-size: 12px;
  color: #8A7A6D;
  font-weight: 600;
  white-space: nowrap;
}
.seg .sg-btn.on {
  background: #FFFFFF;
  color: #D96A1F;
  box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
}
.seg.wide { width: 100%; }
.seg.wide .sg-btn { flex: 1; text-align: center; }

/* 开关 */
.switch {
  width: 46px;
  height: 26px;
  border-radius: 13px;
  background: #E5D9CB;
  position: relative;
  flex-shrink: 0;
  transition: background .2s;
}
.switch.on { background: #EF7D2D; }
.switch .knob {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #FFFFFF;
  transition: left .2s;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .2);
}
.switch.on .knob { left: 23px; }

/* ---------- 免责声明 ---------- */
.disclaim {
  font-size: 10.5px;
  color: #B0A494;
  line-height: 1.65;
  margin: 14px 4px 6px;
  text-align: center;
}
.notice {
  background: #FBE9D8;
  color: #D96A1F;
  border-radius: 10px;
  padding: 9px 12px;
  font-size: 12px;
  line-height: 1.65;
  margin-bottom: 12px;
}

/* ---------- 记录项 ---------- */
.rec-item {
  background: #FFFFFF;
  border-radius: 13px;
  box-shadow: 0 4px 16px rgba(217, 106, 31, .10);
  padding: 12px;
  margin-bottom: 10px;
}
.rec-item .rt {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: #8A7A6D;
  margin-bottom: 6px;
}
.rec-item .rc { font-size: 13.5px; font-weight: 700; line-height: 1.55; }
.rec-item .rm { font-size: 11.5px; color: #8A7A6D; margin-top: 5px; line-height: 1.65; }
.rec-item .ract { display: flex; margin-top: 9px; }

/* ---------- 传感器状态条 ---------- */
.sensor-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10px 0 0;
  font-size: 11.5px;
  color: #8A7A6D;
}
.sensor-strip .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #B8AFA6;
  margin-right: 6px;
  flex-shrink: 0;
}
.sensor-strip .dot.ok { background: #2E8B57; }
.sensor-strip .dot.warn { background: #E8A33D; }

/* ---------- 盘面徽标 ---------- */
.dial-badge {
  background: rgba(255, 255, 255, .94);
  border: 1px solid #F0E2D2;
  color: #3D3229;
  font-size: 13px;
  font-weight: 700;
  padding: 5px 14px;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(217, 106, 31, .12);
  white-space: nowrap;
}
.dial-badge-wrap {
  display: flex;
  justify-content: center;
  margin-top: -14px;
  position: relative;
  z-index: 2;
}

/* ---------- 坐标输入行（罗盘页 / 地图页共用）---------- */
.coord-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.coord-input {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #3D3229;
  margin-right: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(217, 106, 31, .08);
  min-width: 0;
}
.coord-btn {
  background: #EF7D2D;
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.tip-row {
  font-size: 20rpx;
  color: #B0A494;
  line-height: 1.6;
  margin-top: 10rpx;
  padding: 0 6rpx;
}

/* ---------- 测量位置状态条 ---------- */
.pos-strip {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-top: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(217, 106, 31, .08);
}
.pos-strip .pos-ico { font-size: 24rpx; margin-right: 8rpx; }
.pos-strip .pos-txt {
  flex: 1;
  font-size: 22rpx;
  color: #7A6A5B;
  line-height: 1.5;
  word-break: break-all;
}
.pos-strip .pos-act {
  font-size: 22rpx;
  color: #D96A1F;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.pos-title { font-size: 28rpx; font-weight: 800; margin-bottom: 8rpx; }
.pos-desc { font-size: 22rpx; color: #8A7A6D; line-height: 1.7; }

/* ---------- 通用 ---------- */
.mono { font-family: Consolas, Monaco, monospace; letter-spacing: .3px; }
.center { text-align: center; }
.mt8 { margin-top: 8px; }
.mt12 { margin-top: 12px; }
